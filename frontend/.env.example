# Public Privy App ID (safe to expose client-side — same value as
# backend's PRIVY_APP_ID, since Privy's App ID is a public identifier,
# unlike PRIVY_APP_SECRET which must never appear in frontend code).
VITE_PRIVY_APP_ID=

# Backend API base URL.
VITE_API_BASE_URL=http://localhost:8787

# Checkout demo screen's fixed merchant address (design shows a canned
# "Kaya Market $18.50" purchase, not a general merchant-selection UI) — any
# real Monad testnet address works.
VITE_DEMO_MERCHANT_ADDRESS=
