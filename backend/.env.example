# Privy app credentials (Dashboard → App settings → Basics)
PRIVY_APP_ID=
PRIVY_APP_SECRET=

# Authorization key (server-side signer / key quorum) — generate with:
#   openssl ecparam -name prime256v1 -genkey -noout -out private.pem
#   openssl ec -in private.pem -pubout -out public.pem
# Register the public key as a Key Quorum member in the Privy Dashboard
# (Authorization keys -> New key -> Register key quorum, threshold 1). The
# dashboard's paste field is single-line, so paste the DER form instead of
# the PEM (avoids newline corruption in the input):
#   openssl ec -in private.pem -pubout -outform DER | base64 -w0
# Then paste the resulting quorum id here, plus the PRIVATE key converted to
# base64-encoded PKCS8 DER with no headers (required format for
# authorization_context.authorization_private_keys — the SDK will not accept
# the raw SEC1 PEM openssl generates by default):
#   openssl pkcs8 -topk8 -nocrypt -in private.pem -outform DER | base64 -w0
#
# Two separate quorums are needed to test revocation meaningfully:
#   - AGENT key: Taxis backend's session signer (added as an additional_signer,
#     scoped by policy — this is what gets revoked each kill-test / kill-switch).
#   - OWNER key: stands in for the end user's own key. Set as the wallet's
#     owner_id so the app's bare credentials can't fall back to unrestricted
#     access once the agent's session is revoked. In production this role is
#     played by the user's own Privy-managed key, not something Taxis holds.
# Generate both the same way (separate keypairs, separate registered quorums).
PRIVY_AGENT_KEY_QUORUM_ID=
PRIVY_AGENT_PRIVATE_KEY_B64=
PRIVY_OWNER_KEY_QUORUM_ID=
PRIVY_OWNER_PRIVATE_KEY_B64=

# Monad testnet
MONAD_TESTNET_RPC_URL=https://testnet-rpc.monad.xyz
MONAD_TESTNET_CHAIN_ID=10143

# AUSD (Agora) on Monad testnet — confirmed via docs.agora.finance/developer/contract-deployments
AUSD_TESTNET_ADDRESS=0xa9012a055bd4e0eDfF8Ce09f960291C09D5322dC
# AUSD testnet faucet (AgoraFaucet) — call via `npm run privy:fund-ausd`,
# which invokes requestFunds(address) directly rather than the explorer UI.
AUSD_FAUCET_ADDRESS=0xd236c18D274E54FAccC3dd9DDA4b27965a73ee6C

# Addresses used by the kill-test spike (scripts/privy-kill-test.ts)
KILL_TEST_VALID_RECIPIENT=
KILL_TEST_WRONG_RECIPIENT=

# Optional: reuse an existing Privy wallet instead of creating a fresh one on
# every run of privy:kill-test / privy:fund-ausd. Set this once a wallet has
# been funded with test AUSD so you don't need to re-fund on every run.
KILL_TEST_WALLET_ID=

# Quote-signing key (src/quoting/signing.ts) — deliberately separate from
# any Privy quorum key. This is what signs the user-facing quote itself
# (progress.md Section A.3), independent of Privy's own P-256 authorization
# signatures. Any 32-byte secp256k1 private key works; generate with:
#   node -e "console.log('0x' + require('crypto').randomBytes(32).toString('hex'))"
QUOTE_SIGNING_PRIVATE_KEY=
